  function applyManualImport(){
    const raw = manualInput.value.trim();
    if(!raw){ toast('⚠️ لم تكتب أي بيانات', 'warn'); return; }

    const nameCol = findColumnIndex(NAME_COLUMN_NAME);
    const telCol  = findColumnIndex(PHONE_COLUMN_NAME);
    if(nameCol < 0 || telCol < 0){
      toast(`⚠️ لازم يكون فيه أعمدة "${NAME_COLUMN_NAME}" و "${PHONE_COLUMN_NAME}"`, 'err');
      return;
    }

    const lines = raw.split('\n').map(l => l.trim()).filter(Boolean);
    const contacts = [];

    lines.forEach(line => {
      let parts;
      if(line.includes('\t'))      parts = line.split('\t');
      else if(line.includes('،')) parts = line.split('،');
      else if(line.includes(',')) parts = line.split(',');
      else                        parts = line.split(/\s{2,}/);

      const name = (parts[0] || '').trim();
      const tel  = (parts[1] || '').trim();
      if(name || tel) contacts.push({ name, tel });
    });

    if(!contacts.length){ toast('⚠️ لم يتم التعرف على أي جهة اتصال', 'warn'); return; }

    let imported = 0, addedRows = 0;
    const touched = [];

    contacts.forEach(({name, tel}) => {
      let targetRow = -1;
      for(let r = 1; r < data.length; r++){
        const hasName = String(data[r][nameCol] || '').trim();
        const hasTel  = String(data[r][telCol]  || '').trim();
        if(!hasName && !hasTel){ targetRow = r; break; }
      }
      if(targetRow < 0){
        data.push(new Array(data[0].length).fill(''));
        targetRow = data.length - 1;
        addedRows++;
      }
      data[targetRow][nameCol] = name;
      data[targetRow][telCol]  = tel;
      touched.push([targetRow, nameCol], [targetRow, telCol]);
      imported++;
    });

    save(); render();
    requestAnimationFrame(() => {
      touched.forEach(([r,c]) => {
        const td = document.querySelector(`td.cell[data-row="${r}"][data-col="${c}"]`);
        if(td){ td.classList.add('just-imported'); setTimeout(()=>td.classList.remove('just-imported'), 2100); }
      });
    });

    const label = `استيراد يدوي ${imported} جهة اتصال${addedRows ? ` (+${addedRows} صف)` : ''}`;
    recordImmediate(label, 'import-manual');
    toast(`✅ تم استيراد ${imported} جهة اتصال`);
    closeManualModal();
  }

