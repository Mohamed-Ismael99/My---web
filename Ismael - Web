  function applyFilters(){
    let visible = 0;
    const total = data.length - 1;
    document.querySelectorAll('tbody tr:not(.filter-row)').forEach(tr=>{
      const r = +tr.dataset.row;
      if(r === 0){ tr.style.display = ''; return; }
      const row = data[r];
      let match = true;
      for(let c=0;c<filterValues.length;c++){
        const f = (filterValues[c]||'').trim().toLowerCase();
        if(f && !String(row[c]||'').toLowerCase().includes(f)){ match=false; break; }
      }
      tr.style.display = match ? '' : 'none';
      if(match) visible++;
    });
    const cols = data[0]?.length || 0;
    const anyFilter = filterValues.some(v => (v||'').trim());
