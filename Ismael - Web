  async function importContacts(){
    if(!contactsSupported){
      openManualModal();
      toast('⚠️ المتصفح مش بيدعم القراءة المباشرة — استخدم الاستيراد اليدوي', 'warn');
      return;
    }
    try{
      const props = ['name', 'tel'];
      const opts = { multiple: true };
      const contacts = await navigator.contacts.select(props, opts);
      if(!contacts || !contacts.length) return;
      applyImportedContacts(contacts);
    }catch(err){
      if(err && (err.name === 'AbortError' || /cancel/i.test(err.message || ''))) return;
      console.error(err);
      openManualModal();
      toast('⚠️ تعذر الوصول لجهات الاتصال — استخدم الإدخال اليدوي', 'warn');
    }
  }

  function applyImportedContacts(contacts){
    const nameCol = findColumnIndex(NAME_COLUMN_NAME);
    const telCol  = findColumnIndex(PHONE_COLUMN_NAME);
    if(nameCol < 0 || telCol < 0){
      toast(`⚠️ لازم يكون فيه أعمدة "${NAME_COLUMN_NAME}" و "${PHONE_COLUMN_NAME}"`, 'err');
      return;
    }
    let imported = 0;
    let addedRows = 0;
    const touchedCells = [];

    contacts.forEach(contact => {
      const name = (Array.isArray(contact.name) ? contact.name[0] : contact.name) || '';
      const tel  = (Array.isArray(contact.tel)  ? contact.tel[0]  : contact.tel)  || '';
      if(!name && !tel) return;

      let targetRow = -1;
      for(let r = 1; r < data.length; r++){
        const hasName = String(data[r][nameCol] || '').trim();
        const hasTel  = String(data[r][telCol]  || '').trim();
        if(!hasName && !hasTel){ targetRow = r; break; }
      }
      if(targetRow < 0){
        data.push(new Array(data[0].length).fill(''));
        targetRow = data.length - 1;
        addedRows++;
      }
      data[targetRow][nameCol] = name;
      data[targetRow][telCol]  = tel;
      touchedCells.push([targetRow, nameCol]);
      touchedCells.push([targetRow, telCol]);
      imported++;
    });

    if(!imported){ toast('لم يتم استيراد أي بيانات'); return; }
    save(); render();

    requestAnimationFrame(() => {
      touchedCells.forEach(([r,c]) => {
        const td = document.querySelector(`td.cell[data-row="${r}"][data-col="${c}"]`);
        if(td){
          td.classList.add('just-imported');
          setTimeout(()=>td.classList.remove('just-imported'), 2100);
        }
      });
    });

    const label = `استيراد ${imported} جهة اتصال${addedRows ? ` (+${addedRows} صف)` : ''}`;
    recordImmediate(label, 'import-contacts');
    toast(`✅ تم استيراد ${imported} جهة اتصال`);
  }

