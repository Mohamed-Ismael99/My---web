  }
  function deleteColumn(c){
    if(data[0].length<=1){ toast('لا يمكن حذف كل الأعمدة', 'warn'); return; }
    const colLbl = colName(c);
    data.forEach(row=>row.splice(c,1));
    filterValues.splice(c,1);
    save();render();
    recordImmediate(`حذف العمود ${colLbl}`, 'delete-col');
    toast('تم حذف العمود');
  }
  function clearAll(){
    if(!confirm('هل تريد تفريغ كل الخلايا؟ (العناوين هتفضل زي ما هي)'))return;
    data = data.map((row,r) => r===0 ? row.slice() : row.map(()=>''));
    save();render();
    recordImmediate('تفريغ كل البيانات', 'clear');
    toast('تم تفريغ البيانات');
  }
  function resetTable(){
    if(!confirm('سيتم حذف كل البيانات واستعادة الجدول الافتراضي. متأكد؟'))return;
    data = getDefaultData();
    filterValues = new Array(DEFAULT_HEADERS.length).fill('');
    save();render();
    recordImmediate('إعادة تعيين الجدول', 'reset');
    toast('تمت إعادة التعيين');
  }

  let selectedCol=-1,selectedRow=-1;
  function selectColumn(c){
    selectedCol=(selectedCol===c)?-1:c;
    document.querySelectorAll('.col-head').forEach(th=>th.classList.toggle('selected',+th.dataset.col===selectedCol));
    document.querySelectorAll('.row-head').forEach(th=>th.classList.remove('selected'));
    document.querySelectorAll('td.cell').forEach(td=>td.classList.toggle('selected',+td.dataset.col===selectedCol));
  }
  function selectRow(r){
    selectedRow=(selectedRow===r)?-1:r;
    document.querySelectorAll('.row-head').forEach(th=>th.classList.toggle('selected',+th.dataset.row===selectedRow));
    document.querySelectorAll('.col-head').forEach(th=>th.classList.remove('selected'));
    document.querySelectorAll('td.cell').forEach(td=>td.classList.toggle('selected',+td.dataset.row===selectedRow));
  }

  function pasteBlock(r0,c0,text){
    const rows=text.replace(/\r/g,'').split('\n').filter((_,i,a)=>!(i===a.length-1&&a[i]===''));
    rows.forEach((line,i)=>{
      line.split('\t').forEach((val,j)=>{
        const r=r0+i,c=c0+j;
        while(data.length<=r)data.push(new Array(data[0].length).fill(''));
        while(data[0].length<=c)data.forEach(row=>row.push(''));
        data[r][c]=val;
      });
    });
    filterValues.length = data[0].length;
    for(let i=0;i<filterValues.length;i++) if(filterValues[i]==null) filterValues[i]='';
    save();render();
    recordImmediate(`لصق بيانات (${rows.length} صف)`, 'paste');
    toast('تم لصق البيانات');
  }

  function parseTimeToSeconds(str){
    const s=String(str??'').trim();if(!s)return null;
    const m=s.match(/^(\d{1,2}):(\d{2})(?::(\d{2}))?$/);if(!m)return null;
    const h=+m[1],mi=+m[2],sec=+(m[3]||0);
    if(h>23||mi>59||sec>59)return null;
    return h*3600+mi*60+sec;
  }
  function findTimeColumnIndex(){
    if(!data.length)return -1;
    const header=data[0]||[];
    for(let c=0;c<header.length;c++)
      if(String(header[c]).trim()===TIME_COLUMN_NAME) return c;
    return -1;
  }
  function clearAllFlashes(){
    document.querySelectorAll('td.cell.flash-soon, td.cell.flash-overdue')
      .forEach(td=>td.classList.remove('flash-soon','flash-overdue'));
  }
  function checkReminders(){
    if(!alertsEnabled){ clearAllFlashes(); return; }
    clearAllFlashes();
    const col=findTimeColumnIndex(); if(col<0)return;
    const windowSec=Math.max(0,+reminderInput.value||0)*60;
    const flashTotal=FLASH_TOTAL_MIN*60;
    const now=new Date();
    const nowSec=now.getHours()*3600+now.getMinutes()*60+now.getSeconds();
    document.querySelectorAll(`td.cell[data-col="${col}"]`).forEach(td=>{
      const r=+td.dataset.row;
      const raw=data[r]?.[col];
      const t=parseTimeToSeconds(raw); if(t==null)return;
      const diff=t-nowSec;
      const elapsed=windowSec-diff;
      if(elapsed>=0 && elapsed<=flashTotal){
        if(diff>=0) td.classList.add('flash-soon');
        else td.classList.add('flash-overdue');
      }
    });
  }
  function startReminderLoop(){
    if(reminderTimer)clearInterval(reminderTimer);
    checkReminders();
    reminderTimer=setInterval(checkReminders,CHECK_INTERVAL_MS);
  }

  function updateAlertsBtn(){
    if(alertsEnabled){
      toggleBtn.textContent='🔕 إغلاق الوميض';
      toggleBtn.classList.add('alerts-on');toggleBtn.classList.remove('alerts-off');
      reminderBox.classList.remove('disabled');
      toggleBtn.title='إيقاف كل التنبيهات';
    }else{
      toggleBtn.textContent='🔔 تشغيل الوميض';
      toggleBtn.classList.add('alerts-off');toggleBtn.classList.remove('alerts-on');
      reminderBox.classList.add('disabled');
      toggleBtn.title='إعادة تشغيل التنبيهات';
    }
  }
  function toggleAlerts(){
    alertsEnabled=!alertsEnabled;
    saveAlertsState();updateAlertsBtn();checkReminders();
    recordImmediate(alertsEnabled ? 'تشغيل الوميض' : 'إيقاف الوميض', 'toggle-alerts');
    toast(alertsEnabled?'✅ تم تشغيل التنبيهات':'🔕 تم إغلاق الوميض');
  }

  reminderInput.addEventListener('focus', ()=>{
    beginPending('تعديل مدة التنبيه', 'reminder-min');
  });
  reminderInput.addEventListener('input', checkReminders);
  reminderInput.addEventListener('change', ()=>{ commitPending(); checkReminders(); });
  reminderInput.addEventListener('blur', ()=>commitPending());

  function initState(){
    let restoredFromHistory = false;
    if(loadTimeline() && timeline.length){
      restoreState(timeline[timelineIndex].snapshot);
      if(!Array.isArray(data) || !data.length) data = getDefaultData();
      const cols = data[0].length;
      if(!Array.isArray(filterValues)) filterValues = [];
      while(filterValues.length < cols) filterValues.push('');
      filterValues.length = cols;
      save(); saveAlertsState();
      restoredFromHistory = true;
    }
    if(!restoredFromHistory){
      if(!load()) data = getDefaultData();
      if(!Array.isArray(data) || !data.length) data = getDefaultData();
      const cols = data[0].length;
      filterValues = new Array(cols).fill('');
      loadAlertsState();
      timeline = [{
        snapshot: captureState(),
        label: 'الحالة الابتدائية',
        timestamp: Date.now(),
        action: 'init'
      }];
      timelineIndex = 0;
      saveTimeline();
    }
  }

  initState();
  updateAlertsBtn();
  render();
  startReminderLoop();
  updateHistoryUI();
  renderHistoryList();

  (function checkDefaultColumns(){
    const missing = DEFAULT_HEADERS.filter(h => findColumnIndex(h) < 0);
    if(missing.length){
      setTimeout(()=>{
        toast(`ℹ️ أعمدة ناقصة: ${missing.join(' · ')} — ضيفها يدويًا`, 'warn');
      }, 800);
    }
  })();

  document.addEventListener('keydown', e => {
    const key = e.key.toLowerCase();
    if((e.ctrlKey||e.metaKey) && key === 'z' && !e.shiftKey){ e.preventDefault(); undo(); return; }
    if((e.ctrlKey||e.metaKey) && (key === 'y' || (key === 'z' && e.shiftKey))){ e.preventDefault(); redo(); return; }
    if((e.ctrlKey||e.metaKey) && e.key === 'Enter'){
      e.preventDefault();
      if(e.shiftKey) addColumn(); else addRow();
    }
    if((e.ctrlKey||e.metaKey) && key === 's'){ e.preventDefault(); exportToExcel(); }
    if((e.ctrlKey||e.metaKey) && key === 'h'){ e.preventDefault(); toggleHistoryMenu(); }
    if((e.ctrlKey||e.metaKey) && key === 'i'){ e.preventDefault(); importContacts(); }
    if(e.key === 'Escape'){
      if(historyDropdown.classList.contains('open')) closeHistoryMenu();
      if(manualModal.classList.contains('open')) closeManualModal();
    }
  });
</script>
</body>
</html>
