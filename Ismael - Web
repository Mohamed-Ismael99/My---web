  function saveTimeline(){
    const ser = () => JSON.stringify({ timeline: timeline, timelineIndex: timelineIndex });
    try{
      localStorage.setItem(STORAGE_HISTORY, ser());
    }catch(e){
      if(e && (e.name === 'QuotaExceededError' || e.code === 22)){
        while(timeline.length > 10){
          const reduce = Math.max(5, Math.floor(timeline.length / 4));
          timeline = timeline.slice(reduce);
          timelineIndex = Math.max(0, timelineIndex - reduce);
          try{ localStorage.setItem(STORAGE_HISTORY, ser()); renderHistoryList(); return; }catch(e2){}
        }
      }
    }
  }
  function loadTimeline(){
    try{
      const raw = localStorage.getItem(STORAGE_HISTORY);
      if(!raw) return false;
      const parsed = JSON.parse(raw);
      if(parsed && Array.isArray(parsed.timeline) && parsed.timeline.length){
        timeline = parsed.timeline;
        timelineIndex = Math.max(0, Math.min(parsed.timelineIndex ?? timeline.length - 1, timeline.length - 1));
        return true;
      }
    }catch(e){}
    return false;
  }

