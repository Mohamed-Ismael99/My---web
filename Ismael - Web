  function formatTimeAgo(ts){
    const s = Math.floor((Date.now() - ts) / 1000);
    if(s < 5) return 'الآن';
    if(s < 60) return `${s} ث`;
    const m = Math.floor(s / 60);
    if(m < 60) return `${m} د`;
    const h = Math.floor(m / 60);
    if(h < 24) return `${h} س`;
    return `${Math.floor(h / 24)} ي`;
  }
