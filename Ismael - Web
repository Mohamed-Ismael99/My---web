  function handleKey(e,r,c){
    const map={'ArrowUp':[-1,0],'ArrowDown':[1,0],'ArrowLeft':[0,1],'ArrowRight':[0,-1]};
    if(e.key==='Escape'){e.target.blur();return;}
    if(e.key==='Enter'){e.preventDefault();moveTo(r+1,c);return;}
    if(e.key==='Tab'){e.preventDefault();moveTo(r,c+(e.shiftKey?-1:1));return;}
    if(!map[e.key])return;
    const sel=window.getSelection();
    if(sel&&sel.rangeCount){
      const offset=sel.anchorOffset;
      const len=(e.target.textContent||'').length;
      if(e.key==='ArrowLeft'&&offset!==len)return;
      if(e.key==='ArrowRight'&&offset!==0)return;
    }
    e.preventDefault();
    const [dr,dc]=map[e.key];moveTo(r+dr,c+dc);
  }
  function moveTo(r,c){
    if(r<0)r=0;if(c<0)c=0;
    if(r>=data.length)addRow(true);
    if(c>=data[0].length)addColumn(true);
    const target=document.querySelector(`td.cell[data-row="${r}"][data-col="${c}"]`);
    if(target){
      target.focus();
      const range=document.createRange();
      range.selectNodeContents(target);range.collapse(false);
      const sel=window.getSelection();sel.removeAllRanges();sel.addRange(range);
    }
  }

