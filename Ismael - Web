<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>جدول العملاء</title>
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
<script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>
<style>
  :root{
    --bg:#f3f3f3; --sheet-bg:#fff; --border:#d4d4d4;
    --header-bg:#f8f9fa; --header-hover:#e8eaed;
    --accent:#1a73e8; --accent-soft:#e8f0fe;
    --text:#202124; --muted:#5f6368; --danger:#e74c3c;
    --green:#1e8e3e; --purple:#7c3aed;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  body{font-family:'Tajawal',sans-serif;background:var(--bg);color:var(--text);
       height:100vh;display:flex;flex-direction:column;overflow:hidden}

  .toolbar{background:#fff;border-bottom:1px solid var(--border);
    padding:.6rem 1rem;display:flex;gap:.5rem;align-items:center;
    flex-wrap:wrap;box-shadow:0 1px 3px rgba(0,0,0,.05);z-index:30;position:relative}
  .toolbar .brand{font-weight:700;color:var(--accent);margin-inline-end:.5rem;
    display:flex;align-items:center;gap:.4rem}
  .toolbar .brand span{background:var(--accent);color:#fff;width:28px;height:28px;
    display:grid;place-items:center;border-radius:6px;font-size:1rem}
  .toolbar button{font-family:inherit;font-size:.9rem;padding:.5rem .9rem;
    border:1px solid var(--border);background:#fff;color:var(--text);
    border-radius:6px;cursor:pointer;display:inline-flex;align-items:center;
    gap:.35rem;transition:.15s}
  .toolbar button:hover:not(:disabled){background:var(--header-hover);border-color:#bbb}
  .toolbar button:disabled{opacity:.35;cursor:not-allowed}
  .toolbar button.primary{background:var(--accent);color:#fff;border-color:var(--accent)}
  .toolbar button.primary:hover:not(:disabled){background:#1667d1}
  .toolbar button.success{background:var(--green);color:#fff;border-color:var(--green)}
  .toolbar button.success:hover:not(:disabled){background:#157a34}
  .toolbar button.contact{background:var(--purple);color:#fff;border-color:var(--purple)}
  .toolbar button.contact:hover:not(:disabled){background:#6d28d9}
  .toolbar button.history{background:#f1f3f4;border-color:#dadce0;
    font-size:1rem;padding:.45rem .7rem;min-width:38px;justify-content:center}
  .toolbar button.history:hover:not(:disabled){background:#e2e5e8}
  .toolbar button.history .badge{font-size:.68rem;font-weight:700;
    background:var(--accent);color:#fff;padding:1px 6px;border-radius:10px;
    min-width:18px;text-align:center;margin-inline-start:2px}
  .toolbar button.history:disabled .badge{background:#bbb}
  .toolbar button.alerts-on{background:#fff5e6;border-color:#ffd9a0;color:#b26a00}
  .toolbar button.alerts-on:hover:not(:disabled){background:#ffe9c9}
  .toolbar button.alerts-off{background:#e8f5e9;border-color:#a5d6a7;color:#2e7d32}
  .toolbar button.alerts-off:hover:not(:disabled){background:#d4ebd5}
  .toolbar .sep{width:1px;height:24px;background:#ddd;margin:0 .2rem}
  .toolbar .spacer{flex:1}
  .toolbar .status{font-size:.82rem;color:var(--muted);white-space:nowrap}
  .toolbar .reminder-box{display:flex;align-items:center;gap:.4rem;font-size:.85rem;
    color:var(--muted);background:#fff5e6;border:1px solid #ffd9a0;
    padding:.4rem .7rem;border-radius:6px}
  .toolbar .reminder-box input{width:52px;font-family:inherit;font-size:.85rem;
    padding:.25rem .4rem;border:1px solid #ffd9a0;border-radius:4px;
    background:#fff;color:var(--text);text-align:center}
  .toolbar .reminder-box label{display:flex;align-items:center;gap:.3rem}
  .toolbar .reminder-box.disabled{opacity:.45;pointer-events:none}

  .history-wrap{position:relative;display:inline-block}
  .history-dropdown{
    position:absolute;top:calc(100% + 8px);inset-inline-start:0;
    width:360px;max-height:440px;
    background:#fff;border:1px solid #ddd;border-radius:10px;
    box-shadow:0 12px 32px rgba(0,0,0,.18);
    z-index:200;overflow:hidden;
    display:none;flex-direction:column;
  }
  .history-dropdown.open{display:flex}
  .history-dropdown .hd-head{
    padding:.6rem .8rem;border-bottom:1px solid #eee;
    display:flex;justify-content:space-between;align-items:center;
    background:#f8f9fa;font-weight:700;font-size:.9rem
  }
  .history-dropdown .hd-head .info{display:flex;flex-direction:column;gap:.1rem}
  .history-dropdown .hd-head .info small{
    font-weight:400;color:var(--muted);font-size:.72rem
  }
  .history-dropdown .hd-head button{
    border:none;background:transparent;font-size:1.1rem;
    cursor:pointer;color:#888;padding:.2rem .4rem;border-radius:4px
  }
  .history-dropdown .hd-head button:hover{background:#eaeaea;color:#333}
  .history-dropdown .hd-list{flex:1;overflow-y:auto;padding:.3rem 0;max-height:340px}
  .history-dropdown .hd-list::-webkit-scrollbar{width:8px}
  .history-dropdown .hd-list::-webkit-scrollbar-thumb{background:#ccc;border-radius:4px}
  .history-item{
    padding:.5rem .8rem;cursor:pointer;font-size:.84rem;
    display:flex;align-items:center;gap:.55rem;
    border-inline-start:3px solid transparent;
    transition:background .1s;color:var(--text);
  }
  .history-item:hover{background:#f0f3f7}
  .history-item.current{
    background:var(--accent-soft);border-inline-start-color:var(--accent);font-weight:700;
  }
  .history-item.future{opacity:.5}
  .history-item .icon{font-size:1rem;width:22px;text-align:center;flex-shrink:0}
  .history-item .label{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .history-item .time{font-size:.7rem;color:#999;white-space:nowrap;flex-shrink:0}
  .history-item.current .time{color:var(--accent)}
  .hd-empty{padding:1.5rem 1rem;text-align:center;color:#999;font-size:.85rem}
  .hd-foot{
    padding:.5rem;border-top:1px solid #eee;
    display:flex;gap:.4rem;background:#f8f9fa
  }
  .hd-foot button{
    flex:1;padding:.45rem;font-size:.8rem;
    border:1px solid var(--border);border-radius:6px;
    background:#fff;cursor:pointer;font-family:inherit;
    display:inline-flex;align-items:center;justify-content:center;gap:.3rem;
    transition:.15s
  }
  .hd-foot button:hover{background:#eef0f3}
  .hd-foot button.danger{color:var(--danger)}
  .hd-foot button.danger:hover{background:#fdecec;border-color:#f5c2c2}

  .sheet-wrap{flex:1;overflow:auto;padding:1rem}
  table{border-collapse:separate;border-spacing:0;background:var(--sheet-bg);
    table-layout:fixed;box-shadow:0 1px 4px rgba(0,0,0,.08);
    border-radius:8px;overflow:hidden;min-width:100%}
  th, td{border-inline-end:1px solid var(--border);
    border-bottom:1px solid var(--border);padding:0;height:36px;font-size:.9rem}

  th.corner{width:44px;min-width:44px;background:var(--header-bg);
    position:sticky;top:0;inset-inline-start:0;z-index:15}

  thead th.col-head{background:var(--header-bg);position:sticky;top:0;
    z-index:6;color:var(--muted);font-weight:500;text-align:center;
    min-width:130px;cursor:pointer;user-select:none;position:relative}
  thead th.col-head:hover{background:var(--header-hover)}
  thead th.col-head.selected{background:var(--accent-soft);color:var(--accent);font-weight:700}
  thead th.col-head .del{position:absolute;inset-inline-end:4px;top:50%;
    transform:translateY(-50%);width:18px;height:18px;border-radius:50%;
    background:var(--danger);color:#fff;border:none;font-size:11px;
    line-height:1;cursor:pointer;display:none;place-items:center;padding:0}
  thead th.col-head:hover .del{display:grid}

  tbody th.row-head{width:44px;min-width:44px;background:var(--header-bg);
    color:var(--muted);font-weight:500;text-align:center;
    position:sticky;inset-inline-start:0;z-index:4;
    user-select:none;position:relative;transition:background .12s}
  tbody th.row-head:hover{background:var(--header-hover)}
  tbody th.row-head.selected{background:var(--accent-soft);color:var(--accent);font-weight:700}

  tbody th.row-head[draggable="true"]{cursor:grab}
  tbody th.row-head[draggable="true"]:active{cursor:grabbing}
  tbody th.row-head[draggable="true"]::before{content:"⋮⋮";
    position:absolute;inset-inline-start:3px;top:50%;transform:translateY(-50%);
    color:#c0c0c0;font-size:11px;letter-spacing:-3px;
    opacity:0;transition:opacity .15s;pointer-events:none}
  tbody th.row-head[draggable="true"]:hover::before{opacity:1}
  tbody th.row-head[draggable="true"]:hover{background:#dde7f5}

  tbody th.row-head .del{position:absolute;inset-inline-end:4px;top:50%;
    transform:translateY(-50%);width:16px;height:16px;border-radius:50%;
    background:var(--danger);color:#fff;border:none;font-size:10px;
    line-height:1;cursor:pointer;display:none;place-items:center;padding:0}
  tbody th.row-head:hover .del{display:grid}

  tbody tr.dragging{opacity:.35}
  tbody tr.dragging td, tbody tr.dragging th{background:#e8f0fe}
  tbody tr.drag-over-top td, tbody tr.drag-over-top th{
    box-shadow:inset 0 4px 0 0 var(--accent)}
  tbody tr.drag-over-bottom td, tbody tr.drag-over-bottom th{
    box-shadow:inset 0 -4px 0 0 var(--accent)}

  tr.filter-row td, tr.filter-row th{
    background:#e8f0fe;height:36px;position:sticky;top:36px;z-index:3;
    border-inline-end:1px solid var(--border);
    border-bottom:1px solid var(--border);padding:4px 6px}
  tr.filter-row th{width:44px;min-width:44px;inset-inline-start:0;z-index:9;
    background:#d2e3fc;text-align:center;font-size:15px;
    cursor:pointer;color:var(--accent)}
  tr.filter-row th:hover{background:#c0d8fb}
  tr.filter-row input{width:100%;border:1px solid #c9d4e3;border-radius:4px;
    padding:3px 8px;font-family:inherit;font-size:.82rem;
    background:#fff;outline:none;height:26px;color:var(--text)}
  tr.filter-row input:focus{border-color:var(--accent);
    box-shadow:0 0 0 2px rgba(26,115,232,.15)}
  tr.filter-row input:not(:placeholder-shown){
    border-color:var(--accent);background:#fff8e1;font-weight:500}

  td.cell{min-width:130px;padding:6px 10px;outline:none;
    overflow:hidden;white-space:nowrap;text-overflow:ellipsis;
    transition:background .15s}
  td.cell:focus{background:var(--accent-soft);
    box-shadow:inset 0 0 0 2px var(--accent);white-space:normal}
  td.cell.selected{background:var(--accent-soft)}
  @keyframes importFlash{
    0%{background:rgba(124,58,237,.35)}
    100%{background:transparent}
  }
  td.cell.just-imported{animation:importFlash 2s ease-out}

  tbody tr[data-row="0"] td.cell{
    font-weight:700;background:#f8fafd;color:#1a3a6e}
  tbody tr[data-row="0"] td.cell:focus{background:var(--accent-soft)}
  tbody tr[data-row="0"] th.row-head{
    background:#e8f0fe;color:var(--accent);font-weight:700;cursor:default}

  tfoot td, tfoot th{background:var(--header-bg);border-bottom:none;
    position:sticky;bottom:0;z-index:2}
  tfoot button{width:100%;height:100%;border:none;background:transparent;
    color:var(--accent);font-weight:700;font-family:inherit;
    cursor:pointer;padding:.5rem}
  tfoot button:hover{background:var(--accent-soft)}

  @keyframes flashSoon{
    0%,100%{background-color:rgba(231,76,60,.12);color:#c0392b}
    50%{background-color:rgba(231,76,60,.78);color:#fff}}
  @keyframes flashOverdue{
    0%,100%{background-color:#e74c3c;color:#fff}
    50%{background-color:#a5271a;color:#fff}}
  td.cell.flash-soon{animation:flashSoon 1.1s infinite;font-weight:700;
    box-shadow:inset 0 0 0 2px #e74c3c}
  td.cell.flash-overdue{animation:flashOverdue 1.1s infinite;font-weight:700}

  .sheet-wrap::-webkit-scrollbar{width:12px;height:12px}
  .sheet-wrap::-webkit-scrollbar-track{background:#eee}
  .sheet-wrap::-webkit-scrollbar-thumb{background:#bbb;border-radius:6px;border:3px solid #eee}
  .sheet-wrap::-webkit-scrollbar-thumb:hover{background:#999}

  .toast{position:fixed;bottom:24px;inset-inline-start:50%;
    transform:translateX(50%) translateY(80px);
    background:#202124;color:#fff;padding:.7rem 1.2rem;border-radius:8px;
    font-size:.9rem;opacity:0;transition:.3s;pointer-events:none;z-index:100}
  .toast.show{opacity:1;transform:translateX(50%) translateY(0)}
  .toast.warn{background:#b26a00}
  .toast.err{background:#c0392b}

  .modal-bg{
    position:fixed;inset:0;background:rgba(0,0,0,.45);
    display:none;align-items:center;justify-content:center;
    z-index:300;padding:1rem
  }
  .modal-bg.open{display:flex}
  .modal{
    background:#fff;border-radius:14px;padding:1.4rem;
    width:100%;max-width:520px;
    box-shadow:0 20px 60px rgba(0,0,0,.3);
    display:flex;flex-direction:column;gap:.8rem
  }
  .modal h3{font-size:1.1rem;color:var(--accent);
    display:flex;align-items:center;gap:.5rem}
  .modal p{font-size:.85rem;color:var(--muted);line-height:1.7}
  .modal textarea{
    width:100%;min-height:180px;padding:.7rem;
    border:1px solid var(--border);border-radius:8px;
    font-family:inherit;font-size:.9rem;resize:vertical;
    outline:none;line-height:1.7
  }
  .modal textarea:focus{border-color:var(--accent);
    box-shadow:0 0 0 3px rgba(26,115,232,.15)}
  .modal .actions{display:flex;gap:.5rem;justify-content:flex-end}
  .modal .actions button{
    padding:.55rem 1.1rem;border-radius:8px;cursor:pointer;
    font-family:inherit;font-size:.9rem;border:1px solid var(--border);
    background:#fff
  }
  .modal .actions button.primary{
    background:var(--accent);color:#fff;border-color:var(--accent)
  }
  .modal .actions button:hover{background:#f3f3f3}
  .modal .actions button.primary:hover{background:#1667d1}
</style>
</head>
<body>

  <div class="toolbar">
    <div class="brand"><span>▦</span> جدول العملاء</div>

    <button id="undoBtn" class="history" onclick="undo()" disabled title="رجوع">↶ <span class="badge" id="undoCount">0</span></button>
    <button id="redoBtn" class="history" onclick="redo()" disabled title="تقدم">↷ <span class="badge" id="redoCount">0</span></button>

    <div class="history-wrap">
      <button id="historyMenuBtn" class="history" onclick="toggleHistoryMenu(event)" title="سجل التعديلات">
        📜 <span class="badge" id="historyTotal">0</span>
      </button>
      <div class="history-dropdown" id="historyDropdown">
        <div class="hd-head">
          <div class="info">
            <span>سجل التعديلات</span>
            <small id="hdPosition">—</small>
          </div>
          <button onclick="closeHistoryMenu()" title="إغلاق">×</button>
        </div>
        <div class="hd-list" id="hdList"></div>
        <div class="hd-foot">
          <button onclick="clearHistory()" class="danger">🗑 مسح السجل</button>
          <button onclick="closeHistoryMenu()">إغلاق</button>
        </div>
      </div>
    </div>

    <div class="sep"></div>

    <button class="primary" onclick="addRow()">+ صف</button>
    <button class="primary" onclick="addColumn()">+ عمود</button>
    <button class="contact" onclick="importContacts()" title="استيراد من جهات اتصال الهاتف">📱 استيراد جهات اتصال</button>
    <button class="success" onclick="exportToExcel()">📥 تصدير Excel</button>
    <button onclick="clearFilters()">✕ مسح الفلاتر</button>
    <button onclick="clearAll()">🗑 تفريغ الكل</button>
    <button onclick="resetTable()">↺ إعادة تعيين</button>

    <div class="spacer"></div>

    <div class="reminder-box" id="reminderBox" title="التنبيه يعمل على عمود &quot;الوقت&quot;">
      🔔 قبل
      <label><input type="number" id="reminderMin" min="0" max="60" step="1" value="5"> دقيقة</label>
      <span style="color:#888;font-size:.78rem">· وميض 10 د</span>
    </div>

    <button id="toggleAlerts" class="alerts-on" onclick="toggleAlerts()">🔕 إغلاق الوميض</button>

    <div class="status" id="status">—</div>
  </div>

  <div class="sheet-wrap">
    <table id="sheet">
      <thead><tr id="headRow"><th class="corner"></th></tr></thead>
      <tbody id="bodyTable"></tbody>
      <tfoot>
        <tr>
          <th class="row-head" style="cursor:default"></th>
          <td class="add-col-cell" colspan="100" style="padding:0">
            <button onclick="addColumn()">+ إضافة عمود</button>
          </td>
        </tr>
      </tfoot>
    </table>
  </div>

  <div class="modal-bg" id="manualModal">
    <div class="modal">
      <h3>📋 استيراد يدوي</h3>
      <p>الصق الأسماء والأرقام هنا، كل جهة اتصال في سطر منفصل، بين الاسم والرقم فاصلة أو Tab:</p>
      <textarea id="manualInput" placeholder="أحمد محمد, 01012345678
سارة علي, 01198765432
خالد حسن	01234567890"></textarea>
      <div class="actions">
        <button onclick="closeManualModal()">إلغاء</button>
        <button class="primary" onclick="applyManualImport()">استيراد</button>
      </div>
    </div>
  </div>

  <div class="toast" id="toast"></div>

<script>
  const STORAGE_KEY     = 'my-sheet-data-v3';
  const STORAGE_ALERTS  = 'my-sheet-alerts-enabled';
  const STORAGE_HISTORY = 'my-sheet-history-v3';
  const DEFAULT_HEADERS = ['الوقت','الاسم العميل','الكود','المنطقة','رق التواصل','ملاحظات'];
  const DEFAULT_ROWS    = 8;

  const FLASH_TOTAL_MIN   = 10;
  const CHECK_INTERVAL_MS = 20000;
  const TIME_COLUMN_NAME  = 'الوقت';
  const NAME_COLUMN_NAME  = 'الاسم العميل';
  const PHONE_COLUMN_NAME = 'رق التواصل';
  const MAX_HISTORY       = 150;

  const headRow = document.getElementById('headRow');
  const bodyTable = document.getElementById('bodyTable');
  const statusEl = document.getElementById('status');
  const reminderInput = document.getElementById('reminderMin');
  const reminderBox = document.getElementById('reminderBox');
  const toggleBtn = document.getElementById('toggleAlerts');
  const undoBtn = document.getElementById('undoBtn');
  const redoBtn = document.getElementById('redoBtn');
  const undoCount = document.getElementById('undoCount');
  const redoCount = document.getElementById('redoCount');
  const historyMenuBtn = document.getElementById('historyMenuBtn');
  const historyDropdown = document.getElementById('historyDropdown');
  const hdList = document.getElementById('hdList');
  const hdPosition = document.getElementById('hdPosition');
  const historyTotal = document.getElementById('historyTotal');
  const manualModal = document.getElementById('manualModal');
  const manualInput = document.getElementById('manualInput');

  let data = [];
  let filterValues = [];
  let alertsEnabled = true;
  let reminderTimer = null;
  let draggedRow = null;

  let timeline = [];
  let timelineIndex = -1;
  let pendingBefore = null;
  let pendingLabel = '';
  let pendingAction = '';

  function captureState(){
    return JSON.stringify({
      data: data,
      filterValues: filterValues,
      alertsEnabled: alertsEnabled,
      reminderMinutes: reminderInput.value
    });
  }
  function restoreState(str){
    try{
      const s = JSON.parse(str);
      if(!s || !Array.isArray(s.data)) return;
      data = s.data;
      const cols = data[0]?.length || 0;
      filterValues = Array.isArray(s.filterValues) ? s.filterValues.slice() : [];
      while(filterValues.length < cols) filterValues.push('');
      filterValues.length = cols;
      alertsEnabled = s.alertsEnabled !== false;
      if(s.reminderMinutes != null) reminderInput.value = s.reminderMinutes;
    }catch(e){}
  }
  function beginPending(label, action){
    pendingBefore = captureState();
    pendingLabel = label; pendingAction = action;
  }
  function commitPending(){
    if(!pendingBefore) return;
    const after = captureState();
    if(after === pendingBefore){
      pendingBefore = null; pendingLabel=''; pendingAction='';
      return;
    }
    pushToTimeline(after, pendingLabel, pendingAction);
    pendingBefore = null; pendingLabel=''; pendingAction='';
  }
  function recordImmediate(label, action){
    const snap = captureState();
    pushToTimeline(snap, label, action);
  }
  function pushToTimeline(snapshot, label, action){
    if(timelineIndex < timeline.length - 1){
      timeline = timeline.slice(0, timelineIndex + 1);
    }
    if(timeline.length && timeline[timelineIndex].snapshot === snapshot) return;
    timeline.push({
      snapshot: snapshot,
      label: label || '—',
      timestamp: Date.now(),
      action: action || 'edit'
    });
    if(timeline.length > MAX_HISTORY) timeline.shift();
    timelineIndex = timeline.length - 1;
    saveTimeline();
    updateHistoryUI();
    renderHistoryList();
  }
  function undo(){
    if(pendingBefore) commitPending();
    if(timelineIndex <= 0){ toast('لا يوجد تعديل للرجوع إليه'); return; }
    timelineIndex--;
    restoreState(timeline[timelineIndex].snapshot);
    save(); saveAlertsState(); render(); saveTimeline();
    toast(`↶ تم الرجوع · متبقي ${timelineIndex} خطوة`);
  }
  function redo(){
    if(pendingBefore) commitPending();
    if(timelineIndex >= timeline.length - 1){ toast('لا يوجد تعديل للتقدم إليه'); return; }
    timelineIndex++;
    restoreState(timeline[timelineIndex].snapshot);
    save(); saveAlertsState(); render(); saveTimeline();
    toast(`↷ تم التقدم · متبقي ${timeline.length - 1 - timelineIndex} خطوة`);
  }
  function jumpToHistory(index){
    if(index < 0 || index >= timeline.length) return;
    if(index === timelineIndex){ closeHistoryMenu(); return; }
    if(pendingBefore) commitPending();
    timelineIndex = index;
    restoreState(timeline[timelineIndex].snapshot);
    save(); saveAlertsState(); render(); saveTimeline();
    closeHistoryMenu();
    toast(`📍 تم الانتقال للخطوة ${index + 1} من ${timeline.length}`);
  }
  function clearHistory(){
