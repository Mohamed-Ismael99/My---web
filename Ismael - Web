    });
    bodyTable.appendChild(ftr);

    data.forEach((row,r)=>{
      const tr=document.createElement('tr');
      tr.dataset.row = r;
      const rh=document.createElement('th');
      rh.className='row-head';rh.dataset.row=r;

      if(r === 0){
        rh.textContent = '1';
        rh.title = 'صف العناوين';
        rh.style.cursor = 'default';
      }else{
        rh.innerHTML=`<span class="row-num">${r+1}</span>`;
        rh.title = 'اسحب لنقل الصف · اضغط للاختيار';

        const delBtn = document.createElement('button');
        delBtn.className = 'del';
        delBtn.textContent = '×';
        delBtn.title = 'حذف الصف';
        delBtn.draggable = false;
        delBtn.ondragstart = e => { e.preventDefault(); e.stopPropagation(); };
        delBtn.onclick = e => { e.stopPropagation(); deleteRow(r); };
        rh.appendChild(delBtn);

        rh.draggable = true;
        rh.ondragstart = (e) => {
          draggedRow = r;
          e.dataTransfer.effectAllowed = 'move';
          e.dataTransfer.setData('text/plain', String(r));
          tr.classList.add('dragging');
        };
        rh.ondragend = () => {
          draggedRow = null;
          document.querySelectorAll('.dragging, .drag-over-top, .drag-over-bottom')
            .forEach(x => x.classList.remove('dragging','drag-over-top','drag-over-bottom'));
        };
        rh.onclick = () => selectRow(r);
      }
      tr.appendChild(rh);

      row.forEach((val,c)=>{
        const td=document.createElement('td');
        td.className='cell';td.contentEditable='true';
        td.dataset.row=r;td.dataset.col=c;
        td.textContent=val;
        td.onfocus=()=>{
          beginPending(`تحرير خلية ${colName(c)}${r+1}`, 'edit-cell');
          document.querySelectorAll('td.cell.selected').forEach(el=>el.classList.remove('selected'));
          td.classList.add('selected');
        };
        td.oninput=()=>{
          data[r][c]=td.textContent;
          save();
          if(findTimeColumnIndex()===c) checkReminders();
        };
        td.onblur=()=>commitPending();
        td.onkeydown=e=>handleKey(e,r,c);
        td.onpaste=e=>{
          const text=(e.clipboardData||window.clipboardData).getData('text');
          if(text.includes('\t')||text.includes('\n')){
            e.preventDefault();pasteBlock(r,c,text);
          }
        };
        tr.appendChild(td);
      });

      if(r > 0){
        tr.ondragover = (e) => {
          if(draggedRow == null) return;
          e.preventDefault();
          e.dataTransfer.dropEffect = 'move';
          const rect = tr.getBoundingClientRect();
          const y = e.clientY - rect.top;
          tr.classList.remove('drag-over-top','drag-over-bottom');
          if(y < rect.height / 2) tr.classList.add('drag-over-top');
          else tr.classList.add('drag-over-bottom');
        };
        tr.ondragleave = () => {
          tr.classList.remove('drag-over-top','drag-over-bottom');
        };
        tr.ondrop = (e) => {
          e.preventDefault();
          if(draggedRow == null) return;
          const rect = tr.getBoundingClientRect();
          const y = e.clientY - rect.top;
          let targetIndex = y < rect.height / 2 ? r : r + 1;
          if(draggedRow < targetIndex) targetIndex--;
          document.querySelectorAll('.drag-over-top, .drag-over-bottom')
            .forEach(x => x.classList.remove('drag-over-top','drag-over-bottom'));
          if(targetIndex === draggedRow) return;

          const fromR = draggedRow;
          const [moved] = data.splice(draggedRow, 1);
          data.splice(targetIndex, 0, moved);
          save(); render();
          recordImmediate(`نقل صف من ${fromR+1} إلى ${targetIndex+1}`, 'drag-row');
          setTimeout(() => {
            const movedTr = document.querySelector(`tbody tr[data-row="${targetIndex}"]`);
            if(movedTr) movedTr.scrollIntoView({block:'nearest', behavior:'smooth'});
          }, 0);
          toast('✅ تم نقل الصف');
        };
      }

      bodyTable.appendChild(tr);
    });

    filterValues.length = data[0].length;
    for(let i=0;i<filterValues.length;i++) if(filterValues[i]==null) filterValues[i]='';

    save(); applyFilters(); checkReminders(); updateAlertsBtn();
    updateHistoryUI(); renderHistoryList();
  }

  const contactsSupported = (typeof navigator !== 'undefined')
    && ('contacts' in navigator)
