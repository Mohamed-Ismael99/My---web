    if(rowsForExport.length <= 1){ toast('⚠️ لا توجد بيانات للتصدير', 'warn'); return; }

    const ws = XLSX.utils.aoa_to_sheet(rowsForExport);
    ws['!cols'] = rowsForExport[0].map((_, c) => {
      let max = 10;
      rowsForExport.forEach(row => {
